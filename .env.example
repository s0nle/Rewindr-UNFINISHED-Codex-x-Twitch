# Backend-only settings. Never commit real keys or database passwords.
TWELVELABS_API_KEY=
TWELVELABS_INDEX_ID=
# Optional: uses the same TwelveLabs key. No additional text-model key is required.
CANDIDATE_ANALYSIS_ENABLED=true
TWELVELABS_ANALYSIS_MODEL=pegasus1.5
PORT=3000
# API and worker must share this persistent directory (same machine for the demo).
DATA_DIR=.local/rewindr
FFPROBE_PATH=
FFMPEG_PATH=

# Auto-selects Supabase when its settings exist. Set local only for offline work.
PERSISTENCE_MODE=supabase
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=rewindr-chunks
SIGNED_URL_TTL_SECONDS=300
SUPABASE_DB_URL=
# Database Settings > SSL Configuration > Download certificate.
SUPABASE_DB_CA_PATH=.local/rewindr/supabase-ca.crt
# Stable development owner, not proof of a Twitch identity. Never take from requests.
REWINDR_OWNER_ID=00000000-0000-4000-8000-000000000001
# Optional existing HLS source for: npm.cmd run capture:live -- --creator-authorized --input-env LIVE_INPUT_URL
# LIVE_INPUT_URL=https://your-authorized-source.example/live.m3u8
# Twitch Developer Application (separate from the Extension's credentials).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/twitch/callback
# Twitch Extension backend. Expose this separate port via HTTPS, not PORT=3000.
TWITCH_EXTENSION_CLIENT_ID=
TWITCH_EXTENSION_SECRET=
TWITCH_EXTENSION_PREVIOUS_SECRET=
TWITCH_EBS_PUBLIC_URL=
TWITCH_EBS_PORT=3001
# Extra exact HTTPS origins for Local Test frontends, separated by commas.
TWITCH_EXTENSION_ORIGINS=
# Private exported MP4s (separate from source chunks).
SUPABASE_EXPORT_BUCKET=rewindr-exports
# Opt-in hosted onboarding/capture. Requires TWELVELABS_INDEX_ID on the backend.
HOSTED_ONBOARDING_ENABLED=false
HOSTED_MAX_CHANNELS=1
# Comma-separated numeric Twitch IDs allowed to onboard; empty permits any within capacity.
TWITCH_CHANNEL_ALLOWLIST=
# Keep loopback for local/tunnel mode. Containers set 0.0.0.0 behind the HTTPS proxy.
EBS_BIND_ADDRESS=127.0.0.1
# Capture computer only: hosted EBS origin and 30-day credential from the Extension.
REWINDR_API_URL=
REWINDR_AGENT_TOKEN=
# Deployment proxy hostname only, e.g. rewindr.example.com (no scheme/path).
EBS_DOMAIN=
# Optional local demo tunnel; keep the real token only in your untracked .env.
NGROK_AUTHTOKEN=
