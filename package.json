{
  "name": "rewindr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "media:init": "tsx --env-file-if-exists=.env scripts/media-init.ts",
    "media:verify": "tsx --env-file-if-exists=.env scripts/media-verify.ts",
    "media:sweep": "tsx --env-file-if-exists=.env scripts/media-sweep.ts",
    "retention": "tsx --env-file-if-exists=.env scripts/retention.ts",
    "evaluate:broadcast": "tsx --env-file-if-exists=.env scripts/evaluate-broadcast.ts",
    "evaluate:broadcast:review": "tsx scripts/review-broadcast.ts",
    "extension:check": "tsx --env-file-if-exists=.env scripts/check-extension-build.ts",
    "twitch:verify": "tsx --env-file-if-exists=.env scripts/twitch-verify.ts",
    "twitch:check": "tsx --env-file-if-exists=.env scripts/twitch-check.ts",
    "twitch:ebs": "tsx --env-file-if-exists=.env src/twitch-server.ts",
    "twitch:ebs:start": "node --env-file-if-exists=.env dist/src/twitch-server.js",
    "build:extension": "tsc -p web/tsconfig.json && vite build --config web/extension.vite.config.ts",
    "capture:live": "tsx --env-file-if-exists=.env scripts/capture-live.ts",
    "live:verify": "tsx --env-file-if-exists=.env scripts/live-verify.ts",
    "search:verify": "tsx --env-file-if-exists=.env scripts/search-verify.ts",
    "ingest:recording": "tsx --env-file-if-exists=.env scripts/ingest-recording.ts",
    "ingestion:verify": "tsx --env-file-if-exists=.env scripts/ingestion-verify.ts",
    "worker": "tsx --env-file-if-exists=.env src/worker.ts",
    "worker:start": "node --env-file-if-exists=.env dist/src/worker.js",
    "queue:reconcile": "tsx --env-file-if-exists=.env scripts/queue-reconcile.ts",
    "queue:verify": "tsx --env-file-if-exists=.env scripts/queue-verify.ts",
    "storage:verify": "tsx --env-file-if-exists=.env scripts/storage-verify.ts",
    "storage:init": "tsx --env-file-if-exists=.env scripts/storage-init.ts",
    "upload:chunks": "tsx --env-file-if-exists=.env scripts/upload-chunks.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/db-migrate.ts",
    "db:verify": "tsx --env-file-if-exists=.env scripts/db-verify.ts",
    "db:import-local": "tsx --env-file-if-exists=.env scripts/db-import-local.ts",
    "register:chunks": "tsx --env-file-if-exists=.env scripts/register-chunks.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json && tsc -p web/tsconfig.json && vite build --config web/vite.config.ts && vite build --config web/extension.vite.config.ts",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=2 test/*.test.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "evaluate:review": "tsx scripts/review.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "local": "npm run build && npm start"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.6",
    "@fastify/static": "10.1.7",
    "@supabase/supabase-js": "^2.118.0",
    "fastify": "5.12.7",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "twelvelabs-js": "1.3.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@types/node": "26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
